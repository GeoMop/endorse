    <Proxy group="filters" type="PythonCalculator" id="14531" servers="1">
      <Property name="ArrayAssociation" id="14531.ArrayAssociation" number_of_elements="1">
        <Element index="0" value="0"/>
        <Domain name="enum" id="14531.ArrayAssociation.enum">
          <Entry value="0" text="Point Data"/>
          <Entry value="1" text="Cell Data"/>
          <Entry value="2" text="Field Data"/>
        </Domain>
      </Property>
      <Property name="ArrayName" id="14531.ArrayName" number_of_elements="1">
        <Element index="0" value="vel_diff_relmag"/>
      </Property>
      <Property name="CopyArrays" id="14531.CopyArrays" number_of_elements="1">
        <Element index="0" value="1"/>
        <Domain name="bool" id="14531.CopyArrays.bool"/>
      </Property>
      <Property name="Expression" id="14531.Expression" number_of_elements="1">
        <Element index="0" value="np.norm(inputs[0].PointDatasqrt(dot(vel_diff, vel_diff)/maxdot(velocity_p0,velocity_p0))"/>
      </Property>
      <Property name="Input" id="14531.Input" number_of_elements="1">
        <Proxy value="14520" output_port="0"/>
        <Domain name="groups" id="14531.Input.groups"/>
        <Domain name="input_type" id="14531.Input.input_type"/>
      </Property>
      <Property name="MultilineExpression" id="14531.MultilineExpression" number_of_elements="1">
        <Element index="0" value="dv = inputs[0].PointData[&#x27;vel_diff&#x27;]&#xa;v = inputs[0].PointData[&#x27;velocity_p0&#x27;]&#xa;outputArray=np.linalg.norm(dv, axis=1) / np.linalg.norm(v, axis=1)&#xa;return outputArray"/>
      </Property>
      <Property name="ResultArrayType" id="14531.ResultArrayType" number_of_elements="1">
        <Element index="0" value="11"/>
        <Domain name="enum" id="14531.ResultArrayType.enum">
          <Entry value="-1" text="Same as Input"/>
          <Entry value="2" text="Char"/>
          <Entry value="15" text="Signed Char"/>
          <Entry value="3" text="Unsigned Char"/>
          <Entry value="4" text="Short"/>
          <Entry value="5" text="Unsigned Short"/>
          <Entry value="6" text="Int"/>
          <Entry value="7" text="Unsigned Int"/>
          <Entry value="8" text="Long"/>
          <Entry value="9" text="Unsigned Long"/>
          <Entry value="10" text="Float"/>
          <Entry value="11" text="Double"/>
          <Entry value="12" text="Id Type"/>
        </Domain>
      </Property>
      <Property name="UseMultilineExpression" id="14531.UseMultilineExpression" number_of_elements="1">
        <Element index="0" value="1"/>
        <Domain name="bool" id="14531.UseMultilineExpression.bool"/>
      </Property>
    </Proxy>
